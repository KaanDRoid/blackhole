#version 430
// Schwarzschild ray tracer. One invocation per pixel; the host dispatches the
// image in horizontal tiles (u_row_offset) to keep each dispatch short.

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) writeonly uniform image2D img_color;
layout(rgba32f, binding = 1) writeonly uniform image2D img_aux;

uniform ivec2 u_size;
uniform int u_row_offset;
uniform vec3 u_cam_pos;
uniform vec3 u_cam_fwd;
uniform vec3 u_cam_right;
uniform vec3 u_cam_up;
uniform float u_tan_half_fov;  // vertical

#include "geodesic.glsl"
#include "style.glsl"

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy) + ivec2(0, u_row_offset);
    if (pix.x >= u_size.x || pix.y >= u_size.y) return;

    float aspect = float(u_size.x) / float(u_size.y);
    vec2 ndc = vec2((2.0 * (float(pix.x) + 0.5) / float(u_size.x) - 1.0) * aspect,
                    1.0 - 2.0 * (float(pix.y) + 0.5) / float(u_size.y));
    vec3 d = normalize(u_cam_fwd + u_tan_half_fov * (ndc.x * u_cam_right + ndc.y * u_cam_up));

    Hit h = trace(u_cam_pos, d);
    vec3 col = vec3(0.0);
    if (h.status == DISK) col = disk_color(h);
    else if (h.status == ESCAPED) col = background(h.dir);

    imageStore(img_color, pix, vec4(col, 1.0));
    imageStore(img_aux, pix, vec4(float(h.status), float(h.order), h.g, h.r));
}
